{
  "name": "ipad-display",
  "version": "0.2.1",
  "description": "Use an old iPad as a second monitor for Windows and macOS: hardware H.264, sound, touch and gestures",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tools/check.js",
    "setup": "node tools/setup.js",
    "icons": "node tools/make-icons.js",
    "shortcut": "node tools/make-shortcut.js",
    "test-client": "node tools/test-client.js",
    "dist": "electron-builder",
    "helpers:mac": "bash driver/macos/build.sh"
  },
  "license": "MIT",
  "build": {
    "appId": "com.manar.ipaddisplay",
    "productName": "iPad Display",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": [
      "main.js", "preload.js", "panel.html", "i18n.js", "ffenc.js", "usbmux.js", "applaunch.js",
      "client/**", "assets/icon.png", "assets/icon.ico", "driver/**", "tools/*.js", "package.json"
    ],
    "asarUnpack": ["driver/**"],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }, { "target": "zip", "arch": ["arm64", "x64"] }],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Reads the BlackHole virtual audio device to send sound to the iPad.",
        "NSCameraUsageDescription": "Not used."
      }
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "artifactName": "${productName}-${version}-setup-win-${arch}.${ext}" },
    "portable": { "artifactName": "${productName}-${version}-portable-win-${arch}.${ext}" },
    "publish": null
  },
  "dependencies": {
    "bplist-parser": "^0.3.2",
    "plist": "^3.1.1",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manar-mk/ipad-display.git"
  },
  "bugs": {
    "url": "https://github.com/manar-mk/ipad-display/issues"
  },
  "homepage": "https://github.com/manar-mk/ipad-display#readme",
  "author": "Manar Kurmanov"
}
